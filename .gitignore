# Local operating system and editor files
.DS_Store
*.asv
*.autosave
*.swp

# Local runtime environments and generated output
.venv/
__pycache__/
*.pyc
work/
tmp/
logs/

# Measurement projects belong outside the source repository.
# Deliberate, small test fixtures can be committed under tests/fixtures/.
projects/
measurements/
local-config/

# Machine-specific FreeFileSync jobs and synchronization state
*.ffs_gui
*.ffs_batch
*.ffs_db
*.ffs_lock

# Standardized local Python runtime
!.python-version
!requirements.txt
!requirements-tools.txt
!setup_python_environment.m
!PYTHON_ENVIRONMENT.md
**/.venv/
**/.venv.backup_*/
**/.venv.failed_*/
local-config/
